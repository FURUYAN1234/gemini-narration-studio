{
  "name": "gemini-narration-studio",
  "version": "1.3.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node launch.mjs",
    "start:codex": "node launch.mjs --no-browser",
    "test": "node --test runtime/tests/*.test.mjs tests/*.test.mjs",
    "build": "node scripts/preflight.mjs && node scripts/build-public.mjs",
    "preflight": "node scripts/preflight.mjs",
    "postbuild": "node scripts/web-security.mjs --verify-dist",
    "release:preflight": "powershell -ExecutionPolicy Bypass -File ..\\scripts\\release_app_preflight.ps1 -App gemini-narration-studio",
    "predeploy": "npm run release:preflight && npm run build",
    "deploy": "node scripts/deploy-pages.mjs"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.534",
    "@remotion/renderer": "4.0.534",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.534"
  },
  "license": "SEE LICENSE IN LICENSE",
  "description": "Narrated Video Maker / ナレーション動画メーカー: Windowsで素材と台本から声・字幕・BGM付き動画を作成"
}
